   h_c = None\n    max_binder_cumulant = 0\n    max_susceptibility = 0\n\n    for i in range(len(h_values) - 1):\n        h_1, h_2 = h_values[i], h_values[i + 1]\n        delta_h = h_2 - h_1\n\n        if observables[\"U4\"][i] > max_binder_cumulant and observables[\"chi\"][i] > max_susceptibility:\n            max_binder_cumulant = observables[\"U4\"][i]\n            max_susceptibility = observables[\"chi\"][i]\n            h_c = h_1 + (h_2 - h_1) / 2\n\n    return h_c\n\ndef calculate_accuracy(true_values, estimated_values):\n    \"\"\"Calculate the mean absolute deviation of the estimated values from the true values.\"\"\"\n    return np.mean(np.abs(true_values - estimated_values))\n\ndef main():\n    num_spins = 6\n    h_values = np.arange(0.1, 3.05, 0.05)  # h/J, swept from 0.10 to 3.00 in steps of 0.05\n\n    # Prepare quantum circuits and calculate observables\n    observables_all = []\n    for h in h_values:\n        qc = prepare_circuit(num_spins, h)\n        observables = calculate_observables(qc, h)\n        observables_all.append(observables)\n\n    # Estimate the critical point\n    h_c = estimate_critical_point(h_values, observables_all)\n\n    # Calculate accuracy\n    # Here, we assume that the true values are available in the variable \"true_values\"\n    true_values = [0.95, 1.05, 0.85, 1.15, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.05, 1.